# HelixLAB — environment template. Copy to .env and fill. Never commit .env.
# API keys live in environment variables only (invariant 4).

# LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MOONSHOT_API_KEY=
TOGETHER_API_KEY=

# Literature APIs
SCISPACE_API_KEY=
CONSENSUS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Backing services
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/helixlab
REDIS_URL=redis://127.0.0.1:6379/0

# Auth
JWT_SECRET=change-me
JWT_TTL_MINUTES=60