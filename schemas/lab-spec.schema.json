{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixlab.local/schemas/lab-spec.schema.json",
  "title": "HelixLAB Lab Spec",
  "type": "object",
  "required": ["id", "name", "nodes"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "default"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
          "type": { "enum": ["integer", "float", "string", "boolean"] },
          "default": {}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "type": { "enum": ["compute", "literature", "visualization", "logic"] },
        "engine": { "type": "string" },
        "code_template": { "type": "string" },
        "params": { "type": "object" },
        "source": { "type": "string" },
        "query": { "type": "string" },
        "question": { "type": "string" },
        "chart": { "type": "string" },
        "data_ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.output)?$" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Node ids this node consumes. Edges may also be implied by data_ref."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "compute" } } },
          "then": { "required": ["engine"] }
        },
        {
          "if": { "type": "object", "properties": { "type": { "const": "literature" } } },
          "then": { "required": ["source"] }
        }
      ]
    }
  }
}